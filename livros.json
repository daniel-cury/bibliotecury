---
# Gerado pelo Jekyll no GitHub Pages a partir de _livros/ (ordem = nome do arquivo).
# Não precisa editar este arquivo.
---
[{% assign livros = site.livros | sort: "path" %}{% for l in livros %}
  {
    "titulo": {{ l.titulo | jsonify }}, "autor": {{ l.autor | jsonify }}, "ano": {{ l.ano | jsonify }},
    "genero": {{ l.genero | jsonify }}, "paginas": {{ l.paginas | jsonify }}, "nota": {{ l.nota | jsonify }},
    "lido": {{ l.lido | jsonify }}, "cor": {{ l.cor | jsonify }}, "capa": {{ l.capa | jsonify }},
    "texto": {{ l.content | markdownify | jsonify }}
  }{% unless forloop.last %},{% endunless %}{% endfor %}
]
